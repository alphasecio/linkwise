# Copy this file to .env for local development
# DO NOT commit .env to version control

# Required: Get from https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key

# Required: Generate with: openssl rand -hex 32
SECRET_KEY=replace_me_with_a_long_string

# Optional: Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: allow new accounts after the first one (default: false)
ALLOW_SIGNUP=false

# Optional: Database path (default: linkwise.db in current directory)
DB_PATH=linkwise.db
